#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Pyxis golden light_geometry_real — V2.A.19 / PR5: UsdLuxGeometryLight with a real `geometry` rel resolving to an emitting Mesh. The light's position is computed from the bound mesh's extent centroid (not the light prim's local origin); area-for-normalize comes from the AABB surface area. v2.0 closesthit treats this as a point light at the centroid — the M7-full NEE pass replaces with per-triangle area sampling. Pins the rel-resolution + centroid + AABB-area path against the prior stub that always used the light prim's local origin."
)
def Xform "World"
{
    def GeometryLight "EmitterLight"
    {
        color3f inputs:color = (1.0, 0.8, 0.4)
        float inputs:intensity = 5.0
        bool inputs:normalize = true
        rel geometry = </World/Emitter>
    }
    def Mesh "Emitter"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 3]
        point3f[] points = [
            (-0.5, 2.5, -0.5),
            ( 0.5, 2.5, -0.5),
            ( 0.5, 2.5,  0.5),
            (-0.5, 2.5,  0.5),
        ]
        float3[] extent = [(-0.5, 2.5, -0.5), (0.5, 2.5, 0.5)]
        color3f[] primvars:displayColor = [(0.95, 0.95, 0.95)]
    }
    def Cube "Subject"
    {
        double size = 1.2
        color3f[] primvars:displayColor = [(0.85, 0.55, 0.30)]
        double3 xformOp:translate = (0, 0.6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "Camera"
    {
        float focalLength = 35.0
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1.5, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    # Fill light so the cube is visible. The GeometryLight above is
    # loaded but its v2.0 closesthit contribution is zero (Kind::Geometry
    # is "loaded but unused-on-GPU" until M7-full ships NEE area
    # sampling); the dome makes the golden non-trivially black so we
    # actually detect ingest regressions instead of "is the render
    # always black?".
    def DomeLight "DomeLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1.0
    }
}
