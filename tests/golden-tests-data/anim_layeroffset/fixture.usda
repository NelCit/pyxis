#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 100
    timeCodesPerSecond = 24
    subLayers = [
        @./sublayer.usda@ (offset = 50; scale = 1)
    ]
    doc = "Pyxis golden anim_layeroffset — V2.A.13: SdfLayerOffset on a sublayer. The sublayer authors xformOp:translate.timeSamples at sublayer-time 0 (cube far left) and 100 (cube far right); the root sublayers it with offset=50. USD's composition maps stage-time T -> sublayer-time (T - 50), so rendering at stage frame 50 reads the sublayer at frame 0 (cube far left). Catches regressions where attr time-code reads bypass USD's SdfLayerOffset re-mapping."
)
def Xform "World"
{
    def Camera "Camera"
    {
        float focalLength = 35.0
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1.5, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DomeLight "DomeLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1.2
    }
}
