#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Pyxis golden light_filter_attached — V2.A.19 / PR5: DistantLight with a UsdLuxLightFilter attached via light:filters rel. The filter is `loaded but unused-on-GPU until v3` per the plan; rendering must NOT change vs the same light without a filter (no projection / no shadow-tint applied at v2.0). Catches regressions where a filter rel attachment accidentally affects the light's intensity or direction."
)
def Xform "World"
{
    def DistantLight "Sun"
    {
        color3f inputs:color = (1.0, 0.95, 0.85)
        float inputs:intensity = 3.0
        float3 xformOp:rotateXYZ = (-45.0, 30.0, 0.0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        rel light:filters = </World/Filters/CookieA>
    }
    def Scope "Filters"
    {
        def LightFilter "CookieA"
        {
            asset inputs:texture:file = @./nonexistent_cookie.exr@
        }
    }
    def Cube "Subject"
    {
        double size = 1.2
        color3f[] primvars:displayColor = [(0.85, 0.55, 0.30)]
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "Camera"
    {
        float focalLength = 35.0
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1.5, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def DomeLight "DomeLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 0.5
    }
}
