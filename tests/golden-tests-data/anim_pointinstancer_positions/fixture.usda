#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 100
    timeCodesPerSecond = 24
    doc = "Pyxis golden anim_pointinstancer_positions — V2.A.13: UsdGeomPointInstancer.positions animated. Two-cube instancer with positions = (-1.5,1,0),(1.5,1,0) at frame 0 and (0,1,0),(0,2.5,0) at frame 100. Rendered at frame 50 (midpoint) — instances should sit at (-0.75,1,0) and (0.75,1.75,0). Catches regressions where instancer positions read at default time instead of the requested frame. Prototype is a hand-authored UsdGeomMesh cube (PointInstancer prototypes only support direct meshes per EmitPointInstancer)."
)
def Xform "World"
{
    def PointInstancer "Instancer"
    {
        rel prototypes = [</World/Instancer/Prototypes/Cube>]
        int[] protoIndices = [0, 0]
        point3f[] positions.timeSamples = {
            0:   [(-1.5, 1.0, 0.0), (1.5, 1.0, 0.0)],
            100: [(0.0, 1.0, 0.0),  (0.0, 2.5, 0.0)],
        }

        def Scope "Prototypes"
        {
            def Mesh "Cube"
            {
                uniform token subdivisionScheme = "none"
                int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
                int[] faceVertexIndices = [
                    0, 1, 2,  0, 2, 3,
                    4, 6, 5,  4, 7, 6,
                    0, 4, 5,  0, 5, 1,
                    1, 5, 6,  1, 6, 2,
                    2, 6, 7,  2, 7, 3,
                    3, 7, 4,  3, 4, 0
                ]
                point3f[] points = [
                    (-0.4, -0.4,  0.4), ( 0.4, -0.4,  0.4),
                    ( 0.4, -0.4, -0.4), (-0.4, -0.4, -0.4),
                    (-0.4,  0.4,  0.4), ( 0.4,  0.4,  0.4),
                    ( 0.4,  0.4, -0.4), (-0.4,  0.4, -0.4)
                ]
                color3f[] primvars:displayColor = [(0.85, 0.55, 0.30)]
            }
        }
    }

    def Camera "Camera"
    {
        float focalLength = 35.0
        float horizontalAperture = 36.0
        float verticalAperture = 20.25
        float2 clippingRange = (0.1, 1000)
        double3 xformOp:translate = (0, 1.5, 5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DomeLight "DomeLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 1.2
    }
}
