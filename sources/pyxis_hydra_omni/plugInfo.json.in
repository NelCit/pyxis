{
    "Plugins": [
        {
            "Info": {
                "Types": {
                    "HdPyxisRendererPlugin": {
                        "bases": ["HdRendererPlugin"],
                        "displayName": "Pyxis",
                        "_comment": "RFC 0006: priority is NOT a usable lever for the pxr engine's boot delegate. The closed omni.hydra.pxr engine HARDCODES 'HdStormRendererPlugin' as its boot delegate (it ignores GetDefaultPluginId/priority AND /pxr/rendermode at boot, logging 'Could not find HdStormRendererPlugin render-delegate' if Storm is absent -> black viewport). So Storm cannot be removed and priority cannot make Pyxis the default. Reaching Pyxis requires booting Storm then firing a live /pxr/rendermode change-edge (omni.hydra.pyxis module) -- the brief Storm flash is unavoidable with pxr-hosting.",
                        "priority": 0
                    }
                }
            },
            "LibraryPath": "@PYXIS_OMNI_PLUGIN_LIBPATH@",
            "Name": "hdPyxis",
            "ResourcePath": "resources",
            "Root": "..",
            "Type": "library"
        }
    ]
}
